              { "say": "Two!", "popItem": { "group": "plate0", "index": 1, "num": 2 } },
              { "say": "We have two apples on plate one.", "write": null },
              { "say": "Now look at plate two: One!", "popItem": { "group": "plate1", "index": 0, "num": 1 } },
              { "say": "Two!", "popItem": { "group": "plate1", "index": 1, "num": 2 } },
              { "say": "We have two apples on plate two.", "write": null },
              { "say": "Now look at plate three: One!", "popItem": { "group": "plate2", "index": 0, "num": 1 } },
              { "say": "Two!", "popItem": { "group": "plate2", "index": 1, "num": 2 } },
              { "say": "We have two apples on plate three.", "write": null },
              { "say": "Now that we have two apples on each plate, let us count all of them altogether!", "write": null },
              { "say": "One.", "recountItem": { "target": "plate0", "index": 0, "totalNum": 1 } },
              { "say": "Two.", "recountItem": { "target": "plate0", "index": 1, "totalNum": 2 } },
              { "say": "Three.", "recountItem": { "target": "plate1", "index": 0, "totalNum": 3 } },
              { "say": "Four.", "recountItem": { "target": "plate1", "index": 1, "totalNum": 4 } },
              { "say": "Five.", "recountItem": { "target": "plate2", "index": 0, "totalNum": 5 } },
              { "say": "Six! Six apples altogether!", "recountItem": { "target": "plate2", "index": 1, "totalNum": 6 } },
