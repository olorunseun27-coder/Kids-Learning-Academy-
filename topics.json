        "subtopic": "Step-by-step equal sharing",
        "stages": [
          {
            "stageType": "example",
            "title": "Sharing 6 Apples Between 2 People",
            "subtitle": "Stating 6 ÷ 2 = ?, explaining divide, then sharing",
            "speech": "Let us state our division question: 6 ÷ 2 = ?",
            "sequence": [
              { "say": "Look at our board. We want to solve this sharing problem.", "write": null },
              { "say": "Six! We have six apples in total.", "write": "6" },
              { "say": "Divided by! The divide sign means sharing equally between friends.", "write": "÷" },
              { "say": "Two! We are sharing between two children.", "write": "2" },
              { "say": "Equals! This shows each child's fair share.", "write": "=" },
              { "say": "How many apples will each child receive?", "write": "?" },
              { "say": "We want to share six apples equally into two plates.", "write": null },
              { "say": "First, give two apples to child one.", "popItem": { "group": "child1", "index": 0, "num": 1 } },
              { "say": "Two apples for child one.", "popItem": { "group": "child1", "index": 1, "num": 2 } },
              { "say": "Next, give two apples to child two.", "popItem": { "group": "child2", "index": 0, "num": 1 } },
              { "say": "Two apples for child two.", "popItem": { "group": "child2", "index": 1, "num": 2 } },
              { "say": "We have two apples remaining, so let us share one more to child one...", "popItem": { "group": "child1", "index": 2, "num": 3 } },
              { "say": "...and one more to child two!", "popItem": { "group": "child2", "index": 2, "num": 3 } },
              { "say": "Look at both plates: each plate has exactly three apples. Nobody gets more, nobody gets less!", "write": null },
              { "say": "Therefore, six divided by two equals three!", "write": "3", "isResult": true }
            ],
            "boardAction": {
              "type": "DIVISION_SHARING_STEP",
              "icon": "🍎",
              "childCount": 2,
              "eachFinal": 3
            },
            "checkpoint": {
              "questions": [
                {
                  "type": "multiple-choice",
                  "prompt": "Share 8 apples equally between 2 children. How many does each child get (8 ÷ 2)?",
                  "spokenPrompt": "Share eight apples equally between two children. How many does each child get?",
                  "options": ["2", "3", "4", "5"],
                  "correctIndex": 2,
                  "feedback": "8 divided by 2 equals 4."
                }
              ]
            }
          }
        ]
